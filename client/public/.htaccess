# Paramount Psychiatry - React single-page app on GoDaddy cPanel (Apache)
# Lives in /public so Vite copies it into /dist on every build.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Send www to the main domain (one canonical address for Google)
  RewriteCond %{HTTP_HOST} ^www\.paramountpsychiatrynj\.com$ [NC]
  RewriteRule ^(.*)$ https://paramountpsychiatrynj.com/$1 [R=301,L]

  # 2. Serve real files and folders as they are (JS, CSS, images, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Everything else (/about, /services/..., /conditions/...) loads the app
  RewriteRule ^ index.html [L]
</IfModule>

# Cache built assets for a year (their filenames change on every build),
# but always re-check index.html so updates show up right away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpe?g|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
